# ─── Solana RPC Endpoint ─────────────────────────────────────────────────────
# Use a premium RPC (Helius, QuickNode, Alchemy) for mainnet reliability
VITE_RPC_URL=https://api.mainnet-beta.solana.com

# ─── PajCash Off-Ramp Gateway ─────────────────────────────────────────────────
# Your Business API Key from the PajCash merchant dashboard (https://paj.cash)
# This is the only credential needed — no email/OTP required.
VITE_PAJCASH_API_KEY=

# Environment: 'production' | 'staging' | 'local'
VITE_PAJCASH_ENV=production

# Optional: Webhook URL to receive transaction status updates
VITE_PAJCASH_WEBHOOK_URL=

# ─── Supabase Analytics ───────────────────────────────────────────────────────
# Create tables with supabase/p2p_transactions.sql in the Supabase SQL Editor
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Gas Relayer (optional — pays SOL network fees for users) ─────────────────
# Public key shown to the frontend; secret key stays server-side only (Vercel env).
VITE_RELAYER_PUBLIC_KEY=
RELAYER_SECRET_KEY=

# Set to 'true' ONLY if you want PajCash to deposit onramp USDC to the relayer first,
# then forward to the user via api/relay_onramp_fee ($0.10 fee). Leave unset/false
# so onramp USDC goes directly to the connected wallet (recommended).
VITE_ONRAMP_USE_RELAYER=false

# ─── Supabase Server-Side (API routes only — NEVER expose to frontend) ────────
# The service-role key bypasses RLS and is used by api/relay_onramp_fee.js
# to prevent anon-key RLS bypass attacks. Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# ─── WalletConnect / Reown ────────────────────────────────────────────────────
# Required for WalletConnect v2 dApp connections from FiatWallet Explorer.
# Register FREE at https://cloud.walletconnect.com → Create Project → Copy Project ID
# Then add VITE_WC_PROJECT_ID to Vercel environment variables.
VITE_WC_PROJECT_ID=
